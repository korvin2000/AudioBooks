<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NavigationView">
        <attr name="colorSelected" format="color" />
        <attr name="colorUnSelected" format="color" />
        <attr name="backgroundSelected" format="color" />
        <attr name="colorPrimaryText" format="color" />
        <attr name="backgroundItem" format="color" />
        <attr name="hrefColor" format="color" />
        <attr name="subTextColor" format="color" />
        <attr name="backgraundColor" format="color" />
        <attr name="mySelectableItemBackground" format="color" />
        <attr name="colorItemMenu" format="color" />
        <attr name="prefIconColor" format="color" />
        <attr name="deleteColor" format="color" />
        <!-- "My favourite" (a favourite author/reader/book) in content; toolbars keep white icons -->
        <attr name="favoriteColor" format="color" />
        <!-- a chapter's name in the player: its digits and its other symbols, beside the letters' colorPrimaryText -->
        <attr name="chapterDigitColor" format="color" />
        <attr name="chapterSymbolColor" format="color" />
        <!-- a collection the book is in, on its page: a link of its own colour, not hrefColor's -->
        <attr name="collectionColor" format="color" />
    </declare-styleable>
</resources>