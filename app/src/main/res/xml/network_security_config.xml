<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- ISRG Root X1 (SHA-256 96:BC:EC:06:...:BD:DF:08:C6), absent from the API 23-24 system store -->
            <certificates src="@raw/isrg_root_x1" />
            <!-- ISRG Root X2 (SHA-256 69:72:9B:8E:...:CB:14:70), absent before API 34: Let's Encrypt's ECDSA chains
                 (YE1/YE2 via "Root YE", e.g. bookinfo.net, akniga.me) end there -->
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
