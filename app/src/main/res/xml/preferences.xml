<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <ListPreference
        android:defaultValue="@string/theme_dark_value"
        android:dialogTitle="@string/setting_theme"
        android:entries="@array/settings_them_titles"
        android:entryValues="@array/settings_them_values"
        android:icon="@drawable/ic_theme"
        android:key="pref_theme"
        android:title="@string/setting_theme" />

    <ListPreference
        android:defaultValue="@string/abook_value"
        android:dialogTitle="@string/sorce_books"
        android:icon="@drawable/ic_web"
        android:key="sorce_books"
        android:title="@string/sorce_books" />



    <Preference
        android:icon="@drawable/ic_download"
        android:key="pref_download_path"
        android:summary="@string/select_folder"
        android:title="@string/pref_download_path" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_content_cut"
        android:key="cutting_file"
        android:summary="@string/cutting_file_desc"
        android:title="@string/cutting_file" />

    <PreferenceScreen
        android:icon="@drawable/ic_layers_search"
        android:key="source_search"
        android:persistent="true"
        android:summary="@string/source_search_desc"
        android:title="@string/source_search">

        <!-- one checkbox per Provider, added by SettingsFragment -->
    </PreferenceScreen>

    <!-- which book-screen actions are icons in its toolbar; the rest stay in the overflow menu -->
    <PreferenceScreen
        android:icon="@drawable/ic_menu_settings"
        android:key="book_toolbar"
        android:persistent="true"
        android:summary="@string/book_toolbar_desc"
        android:title="@string/book_toolbar">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="toolbar_title"
            android:title="@string/toolbar_title" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="toolbar_favorite"
            android:title="@string/add_to_favorite" />
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="toolbar_share"
            android:title="@string/share" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_download"
            android:title="@string/dowland" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_sleep_timer"
            android:title="@string/sleep_timer" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_equalizer"
            android:title="@string/equalizer" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_settings"
            android:title="@string/menu_settings" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_open_site"
            android:title="@string/open_site" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_main_screen"
            android:title="@string/add_to_main_screen" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="toolbar_refresh"
            android:title="@string/refresh" />
    </PreferenceScreen>


    <ListPreference
        android:defaultValue="@string/books_adapter_layout_list_value"
        android:dialogTitle="@string/books_adapter_layout"
        android:entries="@array/books_adapter_layout_titles"
        android:entryValues="@array/books_adapter_layout_values"
        android:icon="@drawable/ic_list"
        android:key="books_adapter_layout_pref"
        android:title="@string/books_adapter_layout" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_menu_history"
        android:key="history_procent"
        android:summary="@string/history_procent_desc"
        android:title="@string/history_procent" />


    <ListPreference
        android:defaultValue="0"
        android:dialogTitle="@string/setting_start_menu"
        android:entries="@array/settings_start_screen_titles"
        android:entryValues="@array/settings_start_screen_values"
        android:icon="@drawable/ic_application"
        android:key="pref_start_screen"
        android:title="@string/setting_start_menu" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_magnify"
        android:key="search_pref"
        android:summary="@string/search_desc"
        android:title="@string/search" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_web"
        android:key="offline"
        android:summary="@string/ofline_desc"
        android:title="@string/offline" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_rewind"
        android:key="rewind_back"
        android:summary="@string/rewind_desc"
        android:title="@string/rewind_back" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_album"
        android:key="reproductionPref"
        android:summary="@string/reproduction_desc"
        android:title="@string/reproduction" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_auto_play"
        android:key="autoPlayPref"
        android:summary="@string/autoplay_desc"
        android:title="@string/autoplay" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_fast_forward_pref"
        android:key="seekToPausePref"
        android:summary="@string/seekToPauseDesc"
        android:title="@string/seekTo" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_skip_pref"
        android:key="seekButtonsPref"
        android:summary="@string/seek_buttons_desc"
        android:title="@string/seek_buttons" />

    <CheckBoxPreference
        android:defaultValue="true"
        android:icon="@drawable/ic_privacy"
        android:key="safeNavigationPref"
        android:summary="@string/safe_navigation_desc"
        android:title="@string/safe_navigation" />

    <CheckBoxPreference
        android:defaultValue="false"
        android:icon="@drawable/ic_scroll_to"
        android:key="scrollToSelectedPref"
        android:summary="@string/scrollToSelectedDesc"
        android:title="@string/scrollToSelected" />

    <EditTextPreference
        android:defaultValue="60"
        android:icon="@drawable/ic_buffer"
        android:key="bufferSize"
        android:title="@string/buffer_size" />

    <Preference
        android:icon="@drawable/ic_lock"
        android:key="parentalControl"
        android:title="@string/parental_control" />

    <Preference
        android:icon="@drawable/ic_download"
        android:key="download"
        android:summary="@string/downloads_summary"
        android:title="@string/download" />

    <Preference
        android:icon="@drawable/ic_web"
        android:key="cookies"
        android:summary="@string/cookies_site_summary"
        android:title="@string/cookies_site" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:icon="@drawable/ic_web"
        android:key="pref_proxy"
        android:summary="@string/proxy_summary"
        android:title="@string/proxy_title" />

    <ListPreference
        android:defaultValue="@string/sort_value_date"
        android:dialogTitle="@string/setting_sort_favorite"
        android:entries="@array/settings_sort_titles"
        android:entryValues="@array/settings_sort_values"
        android:icon="@drawable/ic_sort"
        android:key="pref_sort_favorite"
        android:title="@string/setting_sort_favorite" />

    <PreferenceScreen
        android:icon="@drawable/ic_import"
        android:key="import"
        android:persistent="true"
        android:summary="@string/import_description"
        android:title="@string/import_favorite">
        <Preference
            android:key="import_kniga_v_uhe"
            android:summary="@string/kniga_v_uhe_description"
            android:title="@string/kniga_v_uhe" />

        <Preference
            android:key="import_abook"
            android:summary="@string/abook_description"
            android:title="@string/abook" />
    </PreferenceScreen>


    <Preference
        android:icon="@drawable/ic_backup"
        android:key="backup"
        android:summary="@string/backup_summary"
        android:title="@string/backup" />

    <Preference
        android:icon="@drawable/ic_restore"
        android:key="restore"
        android:summary="@string/restore_summary"
        android:title="@string/restore" />


    <PreferenceScreen
        android:icon="@drawable/ic_clear"
        android:key="clear"
        android:persistent="true"
        android:title="@string/clear">
        <Preference
            android:key="clear_history_search"
            android:title="@string/clear_history_search" />

        <Preference
            android:key="clear_history"
            android:title="@string/clear_history" />

        <Preference
            android:key="clear_favorite"
            android:title="@string/clear_favorite" />

        <Preference
            android:key="clear_audio_list"
            android:title="@string/clear_audio_list" />

        <Preference
            android:key="clear_savind"
            android:title="@string/clear_saving" />
    </PreferenceScreen>

    <Preference
        android:icon="@drawable/ic_battery"
        android:key="reqest_ignor_battery_optimizetion"
        android:summary="@string/reqest_battary_optimisation"
        android:title="@string/battary_optimize" />


</PreferenceScreen>