<?xml version="1.0" encoding="utf-8"?>
<!-- A narrator's card from fantlab.ru (activity.NarratorActivity), laid out like a source card: the toolbar with the
     name, then the photo, the facts, the biography, the audiobooks and the way to the page itself. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgraundColor"
    tools:context=".activity.NarratorActivity"
    tools:viewBindingIgnore="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <ProgressBar
                android:id="@+id/narratorProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/narratorError"
                style="@style/Widget.App.Sources.Line"
                android:text="@string/narrator_failed"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/narratorPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxHeight="280dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/narratorFacts"
                style="@style/Widget.App.Sources.Line"
                android:visibility="gone"
                tools:text="Страна: Россия\nДата рождения: 29 декабря 1942 г." />

            <TextView
                android:id="@+id/narratorBioTitle"
                style="@style/Widget.App.Sources.Title"
                android:accessibilityHeading="true"
                android:text="@string/narrator_bio"
                android:visibility="gone"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/narratorBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/colorPrimaryText"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/narratorBooksTitle"
                style="@style/Widget.App.Sources.Title"
                android:accessibilityHeading="true"
                android:visibility="gone"
                tools:ignore="UnusedAttribute"
                tools:text="Аудиокниги (42)" />

            <TextView
                android:id="@+id/narratorBooks"
                style="@style/Widget.App.Sources.Line"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/narratorOpen"
                style="@style/Widget.App.Sources.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/narrator_open"
                app:icon="@drawable/ic_open_in_new" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
