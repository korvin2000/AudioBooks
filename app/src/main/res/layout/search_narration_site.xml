<?xml version="1.0" encoding="utf-8"?>
<!-- One site of a recording in the choice of recordings: its icon (the letter shows until the icon is drawn), name and
     the card's own length. The row is the touch target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="6dp"
    android:paddingEnd="24dp"
    android:paddingBottom="6dp"
    tools:viewBindingIgnore="true">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/siteLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="A" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siteIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SourceIcon" />
    </FrameLayout>

    <TextView
        android:id="@+id/siteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="16sp"
        tools:text="Akniga" />

    <TextView
        android:id="@+id/siteTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="?attr/subTextColor"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_clock"
        tools:text="11 ч. 59 мин." />
</LinearLayout>
