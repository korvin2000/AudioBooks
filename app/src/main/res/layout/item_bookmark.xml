<?xml version="1.0" encoding="utf-8"?>
<!-- A mark of sheet_bookmark: the chapter, «12:40 · 13 нояб.», the note when there is one. The row goes there; ⋮
     offers «Заметка…» and «Удалить». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/bookmarkChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="16sp"
            tools:text="Глава 12" />

        <TextView
            android:id="@+id/bookmarkPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="?attr/subTextColor"
            android:textSize="14sp"
            tools:text="12:40 · 13 нояб." />

        <TextView
            android:id="@+id/bookmarkNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Вернуться к этому месту"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmarkMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/bookmark_actions"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_more_vert"
        app:tint="?attr/subTextColor" />
</LinearLayout>
