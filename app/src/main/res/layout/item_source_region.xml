<?xml version="1.0" encoding="utf-8"?>
<!-- A region tile of a source card: the region and whether the site works there without a proxy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_source_tile"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp"
    tools:viewBindingIgnore="true">

    <TextView
        android:id="@+id/sourceRegionName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Россия" />

    <TextView
        android:id="@+id/sourceRegionState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:textSize="12sp"
        tools:text="нужен прокси" />
</LinearLayout>
