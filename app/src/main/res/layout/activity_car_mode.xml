<?xml version="1.0" encoding="utf-8"?>
<!-- «Режим авто» (CarModeActivity): the cover, a big play button over it, the time left in the chapter, its progress,
     and below two half-screen targets, rewind and forward by the seek step. Landscape: layout-land. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/carBackground"
    android:keepScreenOn="true">

    <ImageButton
        android:id="@+id/close"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:background="@drawable/car_close"
        android:contentDescription="@string/car_mode_close"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/carForeground" />

    <!-- as large as fits between the close button and the play button's middle; 2:3 as the app's covers, else the
         loaded cover's own shape (CarModeActivity.fitCover) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="56dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/play"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/close"
        app:layout_constraintWidth_max="300dp"
        app:shapeAppearanceOverlay="@style/CarModeCover" />

    <ImageButton
        android:id="@+id/play"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/car_play"
        android:contentDescription="@string/play"
        android:elevation="6dp"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toTopOf="@id/remaining"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="?attr/carPlayGlyph" />

    <TextView
        android:id="@+id/remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="?attr/carForeground"
        android:textSize="44sp"
        app:layout_constraintBottom_toTopOf="@id/progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="−00:04:12" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:importantForAccessibility="no"
        android:max="1000"
        android:maxHeight="12dp"
        android:minHeight="12dp"
        android:progressDrawable="@drawable/car_progress"
        app:layout_constraintBottom_toTopOf="@id/split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:progress="700" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/split">

        <FrameLayout
            android:id="@+id/rewind"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/car_zone">

            <ImageView
                android:id="@+id/rewindIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                app:tint="?attr/carForeground"
                tools:src="@drawable/ic_rewind_15" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="?attr/carTrack" />

        <FrameLayout
            android:id="@+id/forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/car_zone">

            <ImageView
                android:id="@+id/forwardIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                app:tint="?attr/carForeground"
                tools:src="@drawable/ic_fast_forward_30" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
