<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgraundColor"
    android:orientation="vertical"
    app:behavior_peekHeight="@dimen/player_row_height"
    app:layout_behavior="@string/bottom_sheet_behavior">


    <!-- the folded player: the progress line, then the row. The open player hides the line, and its place is not
         left empty: what follows starts that much higher (the negative margin), and BookActivity.liftPlayer moves
         the row up into the line's place as the sheet opens and keeps the rest below the row while it is folded -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_row_height"
        android:layout_marginBottom="@dimen/player_progress_line_lift"
        android:orientation="vertical"
        tools:showIn="@layout/fragment_book_coments">


        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/player_progress_line" />

        <!-- centred in the row's height: the small vertical padding only leaves the chapter's two lines their room -->
        <LinearLayout
            android:id="@+id/playerTopRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/text_margin"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/text_margin"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/buttonCollapse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/collapse"
                android:src="@drawable/ic_arrow_down_drop_circle_outline" />


            <!-- the chapter selection: close, all/some/none chosen, the count in name_curent, download, delete -->
            <ImageButton
                android:id="@+id/selectionClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/text_margin"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/selection_close"
                android:src="@drawable/ic_close"
                android:visibility="gone" />

            <TextView
                android:id="@+id/radioAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/text_margin"
                android:background="?selectableItemBackground"
                android:drawableStart="@drawable/ic_check_circle_outline"
                android:drawablePadding="@dimen/text_margin_book_description"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:text="@string/all"
                android:textColor="?attr/colorPrimaryText"
                android:visibility="gone" />

            <!-- the playing chapter and, under it, where the book stands (BookActivity.bindProgress) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/text_margin"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name_curent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="?attr/colorPrimaryText"
                    tools:text="0001" />

                <TextView
                    android:id="@+id/name_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/subTextColor"
                    android:textSize="@dimen/subTextSize"
                    android:visibility="gone"
                    tools:text="Глава 3 из 16 · осталось 1 ч. 32 мин."
                    tools:visibility="visible" />
            </LinearLayout>


            <ImageButton
                android:id="@+id/dowland"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/text_margin"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/dowland"
                android:src="@drawable/ic_download"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:src="@drawable/ic_delete"
                android:visibility="gone" />

            <!-- shows or hides the book's block above the chapters (playerBook); only over the open list, and not
                 while chapters are chosen; the padding is its touch area, the margin keeps the icon in the 16dp column -->
            <ImageButton
                android:id="@+id/coverToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="-12dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_cover_show"
                android:padding="12dp"
                android:src="@drawable/ic_image_outline"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtonsControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/previousTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/previous"
                    android:paddingStart="@dimen/text_margin"
                    android:paddingEnd="@dimen/text_margin"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/playTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/play"
                    android:paddingStart="@dimen/text_margin"
                    android:paddingEnd="@dimen/text_margin"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/nextTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="@string/next"
                    android:paddingStart="@dimen/text_margin"
                    android:paddingEnd="@dimen/text_margin"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- what the book's download is doing: state, chapters, bytes, speed, time left; opens the Downloads screen -->
    <LinearLayout
        android:id="@+id/downloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="@dimen/text_margin"
        android:paddingEnd="@dimen/text_margin"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/downloadStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/subTextColor"
            android:textSize="@dimen/subTextSize"
            tools:text="Скачивается · 12/40 глав · 245 МБ из ≈1,1 ГБ · 950 КБ/с · ~15 мин" />

        <ProgressBar
            android:id="@+id/downloadStatusBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:max="100"
            tools:progress="30" />
    </LinearLayout>

    <!-- the book's block, when coverToggle shows it, and the chapters: the block above the list, beside it in
         landscape (BookActivity.setUpPlayerBook) -->
    <LinearLayout
        android:id="@+id/playerBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- as tall as its cover: with the progress line's place it takes three chapter rows, unless a large font
             needs more; the row above leaves the gap over the cover -->
        <LinearLayout
            android:id="@+id/playerBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/playerCover"
                android:layout_width="@dimen/player_cover_width"
                android:layout_height="@dimen/player_cover_height"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/book_cover"
                android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playerBookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="?attr/colorPrimaryText"
                    android:textSize="@dimen/titleSize"
                    android:textStyle="bold"
                    tools:text="На берегу" />

                <TextView
                    android:id="@+id/playerBookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/subTextColor"
                    android:textSize="13sp"
                    tools:text="Невил Шют" />

                <TextView
                    android:id="@+id/playerBookReader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/subTextColor"
                    android:textSize="@dimen/subTextSize"
                    tools:text="читает Имя Чтеца" />

                <ProgressBar
                    android:id="@+id/playerBookProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/book_time_bar_height"
                    android:layout_marginTop="6dp"
                    android:max="1000"
                    android:visibility="gone"
                    tools:progress="150"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/playerBookProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="?attr/subTextColor"
                    android:textSize="@dimen/subTextSize"
                    android:visibility="gone"
                    tools:text="Прослушано 15 % из 2 ч. 41 мин."
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- takes what the block leaves: the height under it, the width beside it -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/text_margin"
        android:paddingTop="@dimen/text_margin"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/timeStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:text="@string/time_zero" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/timeEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:text="@string/time_zero" />

        <!-- the speed as text ("1,5×"), as on the toolbar (BookActivity.bindSpeedButton); opens the speed dialog -->
        <TextView
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/speed"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="64dp"
            android:minHeight="24dp"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:textColor="?attr/colorPrimaryText"
            android:textStyle="bold"
            tools:text="1,5×" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_row_height"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal"
        android:padding="@dimen/text_margin">

        <ImageButton
            android:id="@+id/rewind"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/rewind_10"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rewind_30" />


        <ImageButton
            android:id="@+id/previousBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/playBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/nextBottom"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/forward"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/forward_30"
            android:paddingStart="@dimen/text_margin"
            android:paddingEnd="@dimen/text_margin"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fast_forward_30" />


    </LinearLayout>


</LinearLayout>