<?xml version="1.0" encoding="utf-8"?>
<!-- The head of a source card, like a book's screen: the title with its badges, the tagline and the host, the site's
     mobile page where a book has its cover (or its colour, icon and title when there is no picture), the facts beside
     it, then the two actions. The site's colour tints the background (set in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sourceHead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sourceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:maxLines="2"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="23sp"
            android:textStyle="bold"
            tools:ignore="UnusedAttribute"
            tools:text="Akniga" />

        <TextView
            android:id="@+id/sourceBadgeCatalog"
            style="@style/Widget.App.Sources.Badge"
            android:text="@string/sources_badge_catalog"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sourceBadgeNew"
            style="@style/Widget.App.Sources.Badge"
            android:text="@string/sources_badge_new"
            android:textColor="@color/sources_ok"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/sourceTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/sources_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Клуб с живыми обсуждениями" />

    <TextView
        android:id="@+id/sourceHost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:textColor="@color/sources_link"
        android:textSize="14sp"
        app:drawableEndCompat="@drawable/ic_source_open"
        app:drawableTint="@color/sources_link"
        tools:text="akniga.org" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="180dp">

            <LinearLayout
                android:id="@+id/sourceCoverFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/sourceCoverIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SourceIcon" />

                <TextView
                    android:id="@+id/sourceCoverTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/sourceCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SourceCover" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sourceFactBooks"
                style="@style/Widget.App.Sources.Fact"
                tools:text="≈ 72 тыс. книг · на ноябрь 2026" />

            <TextView
                android:id="@+id/sourceFactServer"
                style="@style/Widget.App.Sources.Fact"
                tools:text="Сервер: за DDoS-Guard" />

            <TextView
                android:id="@+id/sourceFactSince"
                style="@style/Widget.App.Sources.Fact"
                tools:text="Работает с 2014 г." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sourceFactResponse"
                    style="@style/Widget.App.Sources.Fact"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    tools:text="Отклик 0,8 с · 2 ч назад · через прокси" />

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <ImageButton
                        android:id="@+id/sourceCheck"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/sources_check_now"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_refresh"
                        app:tint="@color/sources_link" />

                    <ProgressBar
                        android:id="@+id/sourceChecking"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/sourceFactVpn"
                style="@style/Widget.App.Sources.Fact"
                tools:text="Без VPN · Украина" />

            <TextView
                android:id="@+id/sourceFactUpdates"
                style="@style/Widget.App.Sources.Fact"
                android:visibility="gone"
                tools:text="Новинки: ≈20 книг в день" />

            <TextView
                android:id="@+id/sourceFactMirror"
                style="@style/Widget.App.Sources.Fact"
                android:textColorLink="@color/sources_link"
                android:visibility="gone"
                tools:text="Зеркало: Golosknig" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sourceOpenCatalog"
            style="@style/Widget.App.Sources.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sources_open_catalog"
            app:icon="@drawable/ic_source_playbox" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sourceOpenSite"
            style="@style/Widget.App.Sources.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sources_site"
            app:icon="@drawable/ic_source_open" />
    </LinearLayout>
</LinearLayout>
