<?xml version="1.0" encoding="utf-8"?>
<!-- What a site is: the editors' description, whether it gives whole books and removes books on complaints, then its
     pluses and minuses (SourceCardFragment.bindPlusMinus). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:viewBindingIgnore="true">

    <TextView
        style="@style/Widget.App.Sources.Title"
        android:accessibilityHeading="true"
        android:text="@string/sources_about_title"
        tools:ignore="UnusedAttribute" />

    <TextView
        android:id="@+id/sourceAbout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:textColor="?attr/colorPrimaryText"
        android:textSize="15sp"
        tools:text="Бывший «Аудиокниги Клуб» — старейший из крупных каталогов приложения." />

    <TextView
        android:id="@+id/sourceFragments"
        style="@style/Widget.App.Sources.Line"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        tools:text="@string/sources_fragments_some" />

    <TextView
        android:id="@+id/sourceTakedowns"
        style="@style/Widget.App.Sources.Line"
        android:visibility="gone"
        tools:text="@string/sources_takedowns_yes" />

    <TextView
        android:id="@+id/sourcePlusMinusTitle"
        style="@style/Widget.App.Sources.Title"
        android:accessibilityHeading="true"
        android:text="@string/sources_plus_minus_title"
        tools:ignore="UnusedAttribute" />

    <LinearLayout
        android:id="@+id/sourcePlusMinus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sourcePluses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/sourceMinuses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
