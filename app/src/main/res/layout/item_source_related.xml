<?xml version="1.0" encoding="utf-8"?>
<!-- A related site on a source card: its icon and title, the same catalog or the same new releases, and its place;
     the row opens its card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    tools:viewBindingIgnore="true">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/sourceRelatedLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sourceRelatedIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.SourceIcon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sourceRelatedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="15sp"
            tools:text="Golosknig" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sourceRelatedKind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sources_text_secondary"
                android:textSize="13sp"
                tools:text="@string/sources_related_mirror" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="@color/sources_text_secondary"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/sourceRelatedState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sources_text_secondary"
                android:textSize="13sp"
                tools:text="№ 22 · неактивен" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        style="@style/Widget.App.Sources.RowIcon"
        app:srcCompat="@drawable/ic_source_chevron"
        tools:ignore="ContentDescription" />
</LinearLayout>
