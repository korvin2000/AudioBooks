<?xml version="1.0" encoding="utf-8"?>
<!-- "Источники" (fragment.SourcesFragment) on a phone: the state chips and the sort, then every site
     (adapter.SourcesAdapter). layout-sw600dp-land puts the site's card beside the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgraundColor"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.App.Sources"
    tools:viewBindingIgnore="true">

    <include layout="@layout/sources_list_top" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sourcesList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />
</LinearLayout>
