<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recycler_item_height_genre"
    android:background="@drawable/focusable"
    android:focusable="true"
    android:orientation="horizontal"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginStart="@dimen/text_margin"
                android:layout_marginTop="@dimen/item_genre_title_top_margin"
                android:textColor="?attr/colorPrimaryText"
                tools:text="Фантастика" />

            <TextView
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/text_margin"
                android:layout_marginBottom="@dimen/item_genre_title_top_margin"
                android:gravity="bottom"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/subTextColor"
                android:textSize="@dimen/subTextSize"
                tools:text="Фантастика" />
        </LinearLayout>


        <TextView
            android:id="@+id/reting"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/text_margin"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="?attr/colorPrimaryText"
            android:drawableStart="@drawable/ic_reting"
            tools:text="1840" />

        <!-- the row keeps focus and its D-pad click; GenreListAddapter's key listeners move focus
         to the star on D-pad right and back on D-pad left -->
        <ImageButton
            android:id="@+id/star"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@drawable/focusable"
            android:contentDescription="@string/people_star_add"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_star_toggle"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>