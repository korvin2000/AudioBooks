<?xml version="1.0" encoding="utf-8"?>
<!-- The search screen on TV: the ids of layout/activity_searchable.xml, focus moving down by id. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgraundColor"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".activity.SearchableActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:iconifiedByDefault="false"
                android:nextFocusDown="@+id/sources"
                android:queryHint="@string/search_hint" />
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <HorizontalScrollView
        android:id="@+id/sourcesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusDown="@+id/list"
            android:nextFocusUp="@+id/searchView"
            android:paddingStart="@dimen/margin_small"
            android:paddingEnd="@dimen/margin_small"
            app:chipSpacingHorizontal="@dimen/search_gap"
            app:singleLine="true" />
    </HorizontalScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        app:indicatorColor="?attr/hrefColor"
        app:trackThickness="2dp" />

    <LinearLayout
        android:id="@+id/summaryRow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/search_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_small"
        android:paddingEnd="@dimen/margin_small">

        <TextView
            android:id="@+id/summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/subTextColor"
            android:textSize="@dimen/search_text_size"
            tools:text="Ищем… ответили 7 из 13 · найдено 21" />

        <Button
            android:id="@+id/action"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:minHeight="@dimen/search_row_height"
            android:textColor="?attr/hrefColor"
            android:textSize="@dimen/search_text_size"
            android:visibility="gone"
            tools:text="Повторить (2)" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- one row per kind, as the tiles: the label, then its plates scrolling sideways; the 2dp gap under a
             row sits on its views, so a hidden row takes no room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_small">

            <TextView
                android:id="@+id/autors"
                style="@style/Widget.App.SearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/search_space"
                android:layout_marginBottom="@dimen/search_gap"
                android:visibility="gone"
                tools:text="@string/menu_autor" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/authorList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/search_gap"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/margin_small"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/margin_small">

            <TextView
                android:id="@+id/series"
                style="@style/Widget.App.SearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/search_space"
                android:layout_marginBottom="@dimen/search_gap"
                android:visibility="gone"
                tools:text="Серии" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seriesList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/search_gap"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/margin_small"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nextFocusUp="@+id/sources" />

        <TextView
            android:id="@+id/booksNotFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/text_margin_book_description"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="@dimen/titleSize"
            android:visibility="gone"
            tools:text="@string/search_empty_start" />
    </FrameLayout>

</LinearLayout>
