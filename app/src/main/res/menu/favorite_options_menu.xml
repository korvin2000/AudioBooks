<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/app_bar_search"
        android:icon="@drawable/ic_search_black_24dp"
        android:title="@string/search"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="collapseActionView|always" />

    <item
        android:id="@+id/filter"
        android:icon="@drawable/ic_filter"
        android:title="@string/filter"
        android:visible="false"
        app:showAsAction="always">
        <menu>
            <item
                android:id="@+id/genre_filter"
                android:title="@string/menu_genre" />

            <item
                android:id="@+id/autor_filter"
                android:title="@string/menu_autor" />

            <item
                android:id="@+id/artist_filter"
                android:title="@string/menu_artist" />

            <item
                android:id="@+id/series_filter"
                android:title="@string/filter_series" />

            <!-- the sites of the listed books (FavoritePresenter); the only filter of the history -->
            <item
                android:id="@+id/source_filter"
                android:title="@string/source" />

            <item
                android:id="@+id/saved_filter"
                android:title="@string/menu_saved" />
        </menu>
    </item>

    <item
        android:id="@+id/order"
        android:icon="@drawable/ic_sort"
        android:title="@string/order"
        android:visible="false"
        app:showAsAction="always">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/date"
                    android:title="@string/sort_title_date" />

                <item
                    android:id="@+id/name"
                    android:title="@string/sort_title_name" />

                <item
                    android:id="@+id/genre"
                    android:title="@string/sort_title_genre" />

                <item
                    android:id="@+id/autor"
                    android:title="@string/sort_title_autor" />

                <item
                    android:id="@+id/artist"
                    android:title="@string/sort_title_artist" />

                <item
                    android:id="@+id/series"
                    android:title="@string/sort_title_series" />

                <item
                    android:id="@+id/saved"
                    android:title="@string/sort_title_saved" />
            </group>
        </menu>
    </item>

    <!-- history only: the period of the last opening of the book's page (model.HistoryFilter) -->
    <item
        android:id="@+id/history_period"
        android:icon="@drawable/ic_calendar_range"
        android:title="@string/history_period"
        android:visible="false"
        app:showAsAction="always">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/history_period_all"
                    android:title="@string/history_period_all" />

                <item
                    android:id="@+id/history_period_year"
                    android:title="@string/history_period_year" />

                <item
                    android:id="@+id/history_period_month"
                    android:title="@string/history_period_month" />

                <item
                    android:id="@+id/history_period_week"
                    android:title="@string/history_period_week" />

                <item
                    android:id="@+id/history_period_day"
                    android:title="@string/history_period_day" />
            </group>
        </menu>
    </item>

    <!-- favorites and history only; asks first (FavoriteFragment#confirmClear). Every item is "always": the clear
         icon is a fourth one, it never pushes search, filter or order into the overflow menu -->
    <item
        android:id="@+id/clear_list"
        android:icon="@drawable/ic_delete_sweep"
        android:title="@string/clear_list"
        android:visible="false"
        app:showAsAction="always" />

</menu>