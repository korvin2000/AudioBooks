<?xml version="1.0" encoding="utf-8"?>
<!-- The search screen's toolbar: where to look (scope), the order, and the grouping of the same book. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/search_scope"
        android:icon="@drawable/ic_filter"
        android:title="@string/search_scope"
        app:showAsAction="always" />
    <item
        android:id="@+id/search_sort"
        android:icon="@drawable/ic_sort"
        android:title="@string/search_sort"
        app:showAsAction="always" />
    <item
        android:id="@+id/search_group"
        android:checkable="true"
        android:checked="true"
        android:title="@string/search_group"
        app:showAsAction="never" />
    <item
        android:id="@+id/search_show_score"
        android:checkable="true"
        android:title="@string/search_show_score"
        app:showAsAction="never" />
    <item
        android:id="@+id/search_refresh"
        android:title="@string/search_action_refresh"
        app:showAsAction="never" />
</menu>
