<?xml version="1.0" encoding="utf-8"?>
<!-- Избранное → Жанры (FavoriteGenresFragment): an empty list hides the order and clear items -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/favorite_genres_add"
        android:icon="@drawable/ic_source_plus"
        android:title="@string/favorite_genres_add"
        app:showAsAction="always" />

    <item
        android:id="@+id/order"
        android:icon="@drawable/ic_sort"
        android:title="@string/order"
        app:showAsAction="always">
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/favorite_genres_sort_added"
                    android:title="@string/favorite_genres_sort_added" />

                <item
                    android:id="@+id/favorite_genres_sort_name"
                    android:title="@string/favorite_genres_sort_name" />

                <item
                    android:id="@+id/favorite_genres_sort_picks"
                    android:title="@string/favorite_genres_sort_picks" />
            </group>
        </menu>
    </item>

    <item
        android:id="@+id/clear_list"
        android:icon="@drawable/ic_delete_sweep"
        android:title="@string/clear_list"
        app:showAsAction="always" />
</menu>
