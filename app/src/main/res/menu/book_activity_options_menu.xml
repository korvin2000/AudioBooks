<?xml version="1.0" encoding="utf-8"?>
<!-- Which items are toolbar icons is chosen in the settings ("Панель книги"): BookActivity sets showAsAction. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <group android:id="@+id/menugroup1">
        <item
            android:id="@+id/addFavorite"
            android:icon="@drawable/ic_favorite_add"
            android:title="@string/add_to_favorite"
            android:visible="false"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="ifRoom" />

        <item
            android:id="@+id/removeFavorite"
            android:icon="@drawable/ic_favorite_remove"
            android:title="@string/remove_favorite"
            android:visible="false"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="ifRoom" />

        <!-- the book's author / reader in the favourite people (BookFavorites); hidden when the book names none -->
        <item
            android:id="@+id/favoriteAuthor"
            android:checkable="true"
            android:icon="@drawable/ic_favorite_author"
            android:title="@string/book_fav_author_item"
            android:visible="false"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/favoriteReader"
            android:checkable="true"
            android:icon="@drawable/ic_favorite_reader"
            android:title="@string/book_fav_reader_item"
            android:visible="false"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/share"
            android:icon="@drawable/ic_share"
            android:title="@string/share"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="ifRoom" />

        <!-- the live speed dialog; on the toolbar the value as text (actionLayout), in the overflow "Скорость · 1,5×" -->
        <item
            android:id="@+id/playbackSpeed"
            android:icon="@drawable/ic_play_speed"
            android:title="@string/book_toolbar_speed_pref"
            app:actionLayout="@layout/action_book_speed"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/download_delete"
            android:icon="@drawable/ic_download"
            android:title="@string/dowland_delete"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/sleep_timer"
            android:icon="@drawable/ic_timer"
            android:title="@string/sleep_timer"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/equalizer"
            android:icon="@drawable/ic_equalizer"
            android:title="@string/equalizer"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/settings"
            android:icon="@drawable/ic_menu_settings"
            android:title="@string/book_toolbar_settings"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/openSite"
            android:icon="@drawable/ic_web"
            android:title="@string/open_site"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/addMainScreen"
            android:icon="@drawable/ic_open_in_new"
            android:title="@string/add_to_main_screen"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />

        <item
            android:id="@+id/refresh"
            android:icon="@drawable/ic_restore"
            android:title="@string/refresh"
            app:iconTint="?attr/colorItemMenu"
            app:showAsAction="never" />
    </group>
</menu>
