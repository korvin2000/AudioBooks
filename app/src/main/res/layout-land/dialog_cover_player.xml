<?xml version="1.0" encoding="utf-8"?>
<!-- The cover with the player (CoverPlayer), landscape: the cover on the left, beside it the book's title, the
     chapter, the book's time and the meter, and the buttons at the bottom. A tap anywhere off the buttons closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coverPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/close"
    android:focusable="false"
    android:orientation="horizontal">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/coverImage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:layout_weight="2"
        android:contentDescription="@string/book_cover"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/coverBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:alpha="0.72"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="@dimen/cover_line_size"
            tools:text="На берегу" />

        <include
            layout="@layout/cover_player_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/cover_player_controls" />
    </LinearLayout>
</LinearLayout>
